extends newLayout
block head
    <link href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css" rel="stylesheet">

block content
    .mustWhite
        include header
    .fsTower
        .projWr
            h1.projPage Проекты
            .projBox
                each proj in projects
                    .proj.scroolSpy(onclick="openProj("+proj.id+")" id="project"+proj.id)
                        .projectBox
                            .projectBWr
                                if proj.isVideo == 1
                                    video(src=proj.video muted loop playsinline)
                                else
                                    //img(src=proj.img)
                                    .splide
                                        .splide__track
                                            ul.splide__list
                                                li.splide__slide
                                                    img(src=proj.img)
                                                    each photo in proj.photos
                                                        img(src=photo.filepath)
                            .projTitle
                                .projTitleText #{proj.title}
                                .projTitleDescr #{proj.descr}

    include footer
    script(src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js" )
    script.
        document.querySelectorAll(".splide").forEach(e=>{
            new Splide( e ).mount();
        })
        let videoObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(e => {
                if (e.isIntersecting)
                    e.target.play();
                else
                    e.target.pause();
            })
        }, {
            root: null,
            rootMargin: "10px",
            threshold: .3,
        });
        document.querySelectorAll("video").forEach(e => {
            videoObserver.observe(e);
        })
        async function openProj(id){
            let r=await fetch("/project/"+id);
            let div=document.createElement("div")
            div.classList.add("fsDiv");
            div.innerHTML=await r.text()
            document.querySelectorAll("video").forEach(d => {
                d.pause()
            })
            document.body.appendChild(div)
            document.body.style.overflow="hidden"

        }
        window.onscroll=(e)=>{

            if(window.scrollY>36)
                header.classList.add("bg")
            else
                header.classList.remove("bg")
        }
        if(localStorage.getItem("white"))
            setWhite();
        function setBlack(){
            document.body.classList.remove("whiteBg")
            localStorage.removeItem("white")
        }
        function setWhite() {
            document.body.classList.add("whiteBg");
            localStorage.setItem("white", true)
        }
        const options = {
            root: null,
            rootMargin: "10px",
            threshold: .3,
        };
        let observer = new IntersectionObserver(handleIntersect, options);
        function handleIntersect(entries, observer) {
            entries.forEach(e=>{
                if(e.isIntersecting) {
                    e.target.classList.add("visible")
                    let video=e.target.querySelector("video")
                    if(video)
                        video.play()
                        }
            })
            console.log(entries)

        }
        document.querySelectorAll(".scroolSpy").forEach(e=>{
            observer.observe(e);
        })
        function nextProj(ctrl){
            ctrl.closest(".project").classList.add("noVisible")
            setTimeout(()=>{
                ctrl.closest(".project").classList.add("hidden")
            },1000)

        }
        function firstProj(){
            document.querySelectorAll(".project").forEach(p=>{
                p.classList.remove("noVisible")
                p.classList.remove("hidden")
            })
            console.log(document.querySelector(".projectContainer").scrollLeft)
            document.querySelector(".projectsWr").scrollLeft=0;

        }

