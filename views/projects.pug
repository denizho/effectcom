.projects
    .scroolSpy
        .projectsTitleBox
            .projectsTitleItem
                .projectsTitleHeader.hiLite Проекты
            .projectsTitleItem.decktop
                .projectsTitleAll
                    a.projectsTitleAllTlte(href="/projects") Все проекты
                    .projectsTitleAllIco
                        <svg width="40" height="41" viewBox="0 0 40 41" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M24 9.5L35.5 21M35.5 21L24 32.5M35.5 21H4" stroke="#DDDDDD" stroke-opacity="0.866667" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
        .projectsWr
            .projectContainer
                each proj, i in projects
                    .project
                        .projectGroup
                            .projectContent
                                .projectBox(onclick=="document.location.href='/projects#project"+proj.id+"'")
                                    .projectBWr
                                        if proj.isVideo==1
                                            video.projectVideo(src=proj.video playsinline muted loop preload="none")
                                        else
                                            img(src=proj.img)
                                .projectTitle #{proj.title}
                            .projectNext
                                if i<projects.length-1
                                    .projectNextBtn(onclick="nextProj(this)") Следующий<br>проект
                                else
                                    .projectNextBtn(onclick="firstProj(this)") C<br>начала


        .projectsNext.mobile
            .projectsNextItem
                <svg width="164" height="16" viewBox="0 0 164 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M156 1.5L162.5 8M162.5 8L156 14.5M162.5 8H1" stroke="#DDDDDD" stroke-opacity="0.866667" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

            .projectsNextItem.projectsNextItemText(onclick="ffProj()") Следующий проект
