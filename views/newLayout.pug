    body
        block content
        script.

            function closePopups() {
                document.body.style.overflow = null;
                document.querySelectorAll(".fsDiv").forEach(d => {
                    d.parentNode.removeChild(d)
                    })
                document.querySelectorAll("video").forEach(d => {
                    d.play()
                    })
            }
            async function feedback(){
                let r = await fetch("/feedBackForm/");
                let div = document.createElement("div")
                div.classList.add("fsDiv");
                div.innerHTML = await r.text()
                document.querySelectorAll("video").forEach(d => {
                    d.pause()
                    })
                document.body.appendChild(div)
                document.body.style.overflow = "hidden"
            }
            async function sendFeedback(){
                let dt={};
                document.querySelectorAll(".fbData").forEach(d=>{
                    dt[d.getAttribute('name')]=d.value
                })
                document.querySelector(".feedBackBtnWr").classList.add("hidden")
                document.querySelector(".feedBackSuccess").classList.remove("hidden")
                let token=await grecaptcha.execute('6LcQafkqAAAAAKNERbaoG1KfKbrNXsJSmeUJU3sN', {action: 'submit'})
                let r = await fetch("/api/feedback", {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({dt, token})
                })
            }



