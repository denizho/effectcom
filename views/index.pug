extends layout

block content

    header(style="background-image: url('images/header/header__bg.png');").index
        .header__top
            .header__logo
                img(src="images/header/header__logo.svg", alt="Логотип")
            .header__buttons
                .button.button1
                    span Написать
                    img(src="images/header/header__button1.svg", alt="Иконка", class="icon")
                a.button.button2(href="/projects")
                    span Проекты
                    img(src="images/header/header__button2.svg", alt="Иконка", class="icon")
                .button.button3
                    img(src="images/header/header__button3.svg", alt="Иконка", class="icon-small") 
        .header__bottom
            .header__text
                p
                    |Коммуникации,
                    br 
                    |которые приносят результат!
                    |Организуем мероприятия 
                    br 
                    |от идеи до воплощения
    main
        .main__text 
            .main__text__title 
                p О компании
            p
                |В «
                span.highlight Эффективных коммуникациях
                |» мы верим, что 
                |каждое мероприятие — это возможность создать 
                |уникальный опыт, укрепить связи и достичь 
                |конкретных бизнес-целей. 
                span.highlight Творческий подход, 
                |тщательное планирование и внимание к деталям
                
                |- вот ключ к успешному мероприятию.
            p
                |Наша 
                span.highlight команда 
                |креативных, опытных и 
                |ориентированных на результат 
                span.highlight профессионалов  
                |готова создавать мероприятия, которые не только 
                |привлекут аудиторию, но и укрепят ваш бренд и 
                |обеспечат 
                span.highlight измеримый результат.
            p
                |В работе мы используем 
                span.highlight передовые технологии 
                |и 
                |воплощаем 
                span.highlight комплексные стратегии
                |, от 
                |разработки концепции и логистики до 
                |продвижения и оценки эффективности, чтобы 
                |гарантировать успех вашего мероприятия.
        .main__buttons
            .main__buttons__founded
                .main__buttons__text
                    img(src="images/main/main__buttons__play.svg", alt="Play", width="42", height="76")
                    |2014
                .main__buttons__subtext(style="padding-left: 195px")
                    |Год основания
            .main__buttons__projects
                .main__buttons__text
                    img(src="images/main/main__buttons__play.svg", alt="Play", width="42", height="76")
                    |300+ 
                .main__buttons__subtext(style="padding-left: 175px")
                    |Реализовано проектов
        .main__line
        .outer-container.desktop
            .main__container
                .main__projects
                    .main__projects__title
                        .main__projects__titleGreen
                            p Проекты
                        a.main__projects__titleNight(href="/projects")
                            p Все проекты
                            img(src="images/main/main__projects__arrow.svg", alt="Arrow")
                    .swiper-container.desktop
                        .swiper-wrapper.desktop
                            .swiper-slide
                                .main__projects__video
                                .main__projects__video__subtitle 
                                    p subtitle 1
                            .swiper-slide
                                .main__projects__video
                                .main__projects__video__subtitle 
                                    p subtitle 2
                            .swiper-slide
                                .main__projects__video
                                .main__projects__video__subtitle 
                                    p subtitle 3
                            .swiper-slide
                                .main__projects__video
                                .main__projects__video__subtitle 
                                    p subtitle 1
                            .swiper-slide
                                .main__projects__video
                                .main__projects__video__subtitle 
                                    p subtitle 2
                            .swiper-slide
                                .main__projects__video
                                .main__projects__video__subtitle 
                                    p subtitle 3
                .main__projects__nextel(id="next-project") 
                    p Следующий 
                    | проект
        .main__projects.mobile
            .main__projects__title
                .main__projects__titleGreen
                    p Проекты
            .swiper-container.mobile
                .swiper-wrapper.mobile
                    .swiper-slide.mobile
                        .main__projects__video
                        .main__projects__video__subtitle
                            p SubTitle
                    .swiper-slide.mobile
                        .main__projects__video
                        .main__projects__video__subtitle
                            p SubTitle2
                    .swiper-slide.mobile
                        .main__projects__video
                        .main__projects__video__subtitle
                            p SubTitle3
            .main__projects__next#next-projectmob
                img(src="images/main/main__projects__arrowMobile.svg")
                p Следующий проект
            a.main__projects__button(href="/projects")
                button Все проекты
    footer
        .footer__container
            .footer__content
                .footer__logo 
                    img(src="images/footer/footer__logo.svg")
                .footer__data 
                    p 2014-2025 © ООО «ЭффектКомм». ИНН 7716792536
            .footer__contact
                .footer__tel
                    img(src="images/footer/footer__tel.svg")
                    p +7(495) 226-31-26 
                .footer__email
                    img(src="images/footer/footer__email.svg")
                    p info@effectcomm.ru
    script(src="javascripts/utils.js")
    script(src="https://unpkg.com/swiper/swiper-bundle.min.js")
    script.
        const swiper = new Swiper('.swiper-container.desktop', {
        loop: true,
        slidesPerView: '1',
        spaceBetween: 250,
        centeredSlides: true, 
        });
        const nextProjectButton = document.getElementById('next-project');
        nextProjectButton.addEventListener('click', () => {
        swiper.slideNext();
        });
       
        const swipermob = new Swiper('.swiper-container.mobile', {
        loop: true,
        slidesPerView: 1, 
        spaceBetween: 20,
        });
        const nextProjectButtonmob = document.getElementById('next-projectmob');
        nextProjectButtonmob.addEventListener('click', () => {
            swipermob.slideNext();
        });